# ─────────────────────────────────────────────────────────────────────────────
# Everything below is OPTIONAL. With no .env at all this repo runs fully
# offline against a bundled mock, for $0. You only need a key to run for real.
# ─────────────────────────────────────────────────────────────────────────────

# A sandbox key never bills. Get one at https://coasty.ai/developers/keys
# COASTY_API_KEY=sk-coasty-test-xxxxxxxx

# Where requests go. UNSET means the bundled offline mock — never production.
# COASTY_BASE_URL=https://coasty.ai/v1

# Destination consent, separate from cost consent. Required before any request
# can reach the real, billable API. Without it a live key still fails closed.
# COASTY_ALLOW_LIVE=1
